# Apenas configuração pública; nunca adicionar senhas ou tokens.
VITE_API_URL=/p11-api
# p11 (referência V2) ou legacy (API presente na base Git)
VITE_API_PROFILE=p11
# Composição local: contratos de projeções P11. Em conexão com VM, restrinja ao escopo confirmado.
VITE_P11_RESOURCES=all
# Somente processo Vite; não é incorporado no bundle. Túnel SSH manual no Windows.
HARPI_API_TUNNEL_TARGET=http://127.0.0.1:18000
