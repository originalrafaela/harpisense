{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harpisense:config.proposal:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "config.proposal"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]{8,128}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "reason_code": {
      "enum": [
        "INITIAL_IMPORT",
        "ADMIN_CHANGE",
        "RESTORE"
      ]
    },
    "document": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:harpisense:config.document:1.0.0",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "record_type": {
          "const": "config.document"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_+/-]+$"
            },
            "network_cidrs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "sensor_bindings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "properties": {
                  "sensor_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "network": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "observation_point": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  }
                },
                "required": [
                  "sensor_id",
                  "network",
                  "observation_point"
                ],
                "additionalProperties": false
              }
            },
            "capture_filter_profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "capture_window_seconds": {
              "type": "integer",
              "const": 10
            },
            "feature_schema_version": {
              "const": "harpisense.if.window.v1"
            },
            "mqtt_broker_host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "mqtt_broker_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "mqtt_tls_mode": {
              "const": "required"
            },
            "mqtt_ca_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "mqtt_identity_secret_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^secret://[a-z0-9][a-z0-9-]{0,31}/[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "mqtt_topics": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9_./-]+$"
              }
            },
            "mqtt_client_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "rf_model_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "if_model_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "protocol_adapter_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "external_credential_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^secret://[a-z0-9][a-z0-9-]{0,31}/[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "vpn_auth_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^secret://[a-z0-9][a-z0-9-]{0,31}/[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "parameters"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "idempotency_key",
    "expected_revision",
    "reason_code",
    "document"
  ],
  "additionalProperties": false
}
